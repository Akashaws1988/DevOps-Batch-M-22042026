pipeline {
    agent any

    environment {
        APP_NAME = "my-app"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git url: 'https://github.com/Akashaws1988/DevOps-Batch-M-22042026.git', branch: 'prod'
            }
        }

        stage('Build') {
            steps {
                echo "Building the application..."
                sh 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                echo "Running tests..."
                sh 'mvn test'
            }
        }

        stage('Package') {
            steps {
                echo "Packaging the application..."
                sh 'mvn package'
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying the application..."
                sh 'scp target/*.jar user@server:/deploy/path/'
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution completed.'
        }
        success {
            echo 'Build succeeded!'
        }
        failure {
            echo 'Build failed!'
        }
    }
}
